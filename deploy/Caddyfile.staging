# Host Caddy: import this file from /etc/caddy/Caddyfile.
# Keep the global log redaction block from deploy/Caddyfile in the main config.
# Replace these default hostnames if using a different staging domain.
(staging_backend) {
    reverse_proxy 127.0.0.1:5274 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
        header_up -Forwarded
    }
}
(staging_frontend) {
    reverse_proxy 127.0.0.1:5273 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
        header_up -Forwarded
    }
}
{$STAGING_COMPANY_DOMAIN:weddinvita.cloud} {
    header X-Robots-Tag "noindex, nofollow, noarchive"
    handle / {
        redir * /company 302
    }
    handle /company/dashboard {
        redir https://{$STAGING_CMS_DOMAIN:dashboard.weddinvita.cloud}/ 302
    }
    @company path /company /company/ /company.html /terms /terms/ /privacy /privacy/ /cookie-policy /cookie-policy/ /refund-policy /acceptable-use /robots.txt /sitemap.xml /assets/*
    handle @company {
        import staging_frontend
    }
    handle {
        respond "Not found" 404
    }
}
{$STAGING_CMS_DOMAIN:dashboard.weddinvita.cloud} {
    header X-Robots-Tag "noindex, nofollow, noarchive"
    @backend path /api/payments/midtrans/notification /api/admin/* /api/invitation /api/wishes /media/* /preview-image/* /preview /healthz
    handle @backend {
        import staging_backend
    }
    handle {
        import staging_frontend
    }
}
{$STAGING_INVITATION_DOMAIN:invitation.weddinvita.cloud} {
    header X-Robots-Tag "noindex, nofollow, noarchive"
    log_skip /u/*
    handle /company/dashboard {
        redir https://{$STAGING_CMS_DOMAIN:dashboard.weddinvita.cloud}/ 302
    }
    @cms path /admin /admin/* /api/admin/* /api/payments/* /preview
    handle @cms {
        respond "Not found" 404
    }
    handle /assets/* {
        import staging_frontend
    }
    @company path /company /company/ /company.html /terms /terms/ /privacy /privacy/ /cookie-policy /cookie-policy/ /refund-policy /acceptable-use /robots.txt /sitemap.xml
    handle @company {
        import staging_frontend
    }
    handle {
        import staging_backend
    }
}
