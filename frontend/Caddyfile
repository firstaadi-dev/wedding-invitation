{
    admin off
    auto_https off
}
:8080 {
    root * /srv
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Cache-Control no-cache
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-src https://www.google.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    }
    redir /company/dashboard /admin 302
    @company path /company /company/ /company.html
    handle @company {
        rewrite * /company.html
        file_server
    }
    @admin path / /admin /admin/
    handle @admin {
        rewrite * /admin.html
        file_server
    }
    @crawler path /robots.txt /sitemap.xml
    handle @crawler {
        file_server
    }
    @assets path /assets/*
    handle @assets {
        file_server
    }
    handle /healthz-frontend {
        respond "ok"
    }
    handle {
        respond "Not found" 404
    }
}
