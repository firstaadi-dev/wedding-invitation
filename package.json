{
  "name": "wedding-invitation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TEMPLATE_DIR=frontend node scripts/backend.mjs serve",
    "start": "node scripts/backend.mjs serve",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "node scripts/build.mjs",
    "db:migrate": "node scripts/backend.mjs migrate",
    "admin:hash": "node scripts/backend.mjs hash",
    "test": "node tests/entrance.test.mjs && node --test tests/countdown.test.mjs tests/whatsapp.test.mjs tests/admin-data.test.mjs tests/access.test.mjs tests/identification.test.mjs tests/build.test.mjs && go -C backend test -trimpath ./... && python3 -m unittest discover -s tests -p \"*_test.py\"",
    "test:integration": "node --test tests/api.test.mjs",
    "test:deploy": "python3 tests/compose_smoke.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  }
}
