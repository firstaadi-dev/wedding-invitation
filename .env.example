DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.neon.tech/neondb?sslmode=require
PUBLIC_ORIGIN=http://invitation.localhost:5173
CMS_ORIGIN=http://dashboard.localhost:5173
PORT=5174
LISTEN_HOST=127.0.0.1
NODE_ENV=development
# Set to 1 only behind a trusted reverse proxy; block direct public access to the app port.
TRUST_PROXY=0
# Bootstrap migration only: preserves the existing password for firstaadip16@gmail.com.
# Generate with npm run admin:hash, using a password supplied on stdin.
ADMIN_PASSWORD_HASH=
FINGERPRINT_PUBLIC_KEY=
FINGERPRINT_SECRET_KEY=
FINGERPRINT_REGION=ap
# Set only after the subdomain status is Active in Fingerprint.
FINGERPRINT_ENDPOINT=

# Local HTTP simulation only; leave unset in production.
# FINGERPRINT_API_ORIGIN=http://127.0.0.1:4900/fingerprint

# Midtrans Snap. Use Sandbox keys for staging; server key stays on the backend.
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
