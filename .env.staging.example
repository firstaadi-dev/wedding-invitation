# Copy this file to .env.staging, then fill in staging-only credentials.
# On the VPS install it as /opt/wedding-invitation-staging/app.env (mode 600).
# Raw values: do not surround values with quotes.
# Use a separate Neon branch/database; never use production connections.
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_POOLER_HOST/STAGING_DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_DIRECT_HOST/STAGING_DATABASE?sslmode=require
PUBLIC_ORIGIN=https://invitation.weddinvita.cloud
CMS_ORIGIN=https://dashboard.weddinvita.cloud
# Keep production mode for HTTPS cookies and production-like behavior.
NODE_ENV=production
LISTEN_HOST=0.0.0.0
PORT=5174
TRUST_PROXY=1
# Required for migration 1 on a fresh database. Generate using npm run admin:hash.
# A database cloned after migration 1 retains its existing accounts/passwords.
ADMIN_PASSWORD_HASH=
FINGERPRINT_PUBLIC_KEY=
FINGERPRINT_SECRET_KEY=
FINGERPRINT_REGION=ap
# Set after the staging Fingerprint endpoint is Active; allow the staging origin.
FINGERPRINT_ENDPOINT=

# Midtrans Snap. Use Sandbox keys for staging; server key stays on the backend.
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
